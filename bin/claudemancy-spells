#!/usr/bin/env bash
# Prints the grimoire for /spells, building the binary first if needed.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if ! out=$("$here/../build.sh" --if-stale 2>&1); then
  echo "claudemancy could not be built (needs Go ≥1.24 and network access for the first build):"
  tail -5 <<<"$out"
  exit 0
fi
exec "$here/claudemancy" --list
