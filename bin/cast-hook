#!/usr/bin/env bash
# UserPromptSubmit hook: when the prompt is /cast, open the canvas *before* the
# model runs (so it pops instantly), then tell Claude what the sigil cast: a
# skill, or a prompt spell's instruction. Anything typed after /cast is passed
# along as extra instructions.
set -uo pipefail

input=$(cat)
prompt=$(jq -r '.prompt // ""' <<<"$input")
[[ $prompt =~ ^[[:space:]]*/(claudemancy:)?cast([[:space:]]+(.*))?$ ]] || exit 0
extra=${BASH_REMATCH[3]:-}
project=$(jq -r '.cwd // empty' <<<"$input")

result=$("$(dirname "${BASH_SOURCE[0]}")/claudemancy-popup" ${project:+--project "$project"})
skill=$(jq -r '.skill // empty' <<<"$result" 2>/dev/null)
instruction=$(jq -r '.prompt // empty' <<<"$result" 2>/dev/null)
if [[ -z $skill && -z $instruction ]]; then
  err=$(jq -r '.error // empty' <<<"$result" 2>/dev/null)
  jq -n --arg e "${err:-the spell was dismissed}" '{decision: "block", reason: ("✦ " + $e)}'
  exit 0
fi

spell=$(jq -r '.spell' <<<"$result")
if [[ -n $skill ]]; then
  args=$(jq -r '.args // ""' <<<"$result")
  ctx="claudemancy: the user drew the sigil for \"$spell\". Invoke the \`$skill\` skill now with the Skill tool"
  [[ -n $args ]] && ctx+=", args: \"$args\""
  ctx+=". Don't ask for confirmation or comment on the spell."
  ctx+=" Guard: if a \`$skill\` run started earlier in this session is still in progress (you have not yet received its completion notification), do not start another; reply only that $spell is still being cast."
else
  ctx="claudemancy: the user drew the sigil for \"$spell\", which asks you to do this now, as if they had typed it: $instruction"
  ctx+=" Don't comment on the spell."
fi
[[ -n $extra ]] && ctx+=" The user added these instructions for it: $extra"
jq -n --arg c "$ctx" '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext: $c}}'
